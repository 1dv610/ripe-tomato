{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite-dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$",
          "file": 0,
          "location": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(.*)",
          "endsPattern": "ready in"
        }
      }
    }
  ]
}
